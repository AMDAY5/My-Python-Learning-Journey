   "source": [
    "# 计算长方形的周长和面积\n",
    "length = float(input(\"请输入长：\"))\n",
    "width = float(input(\"请输入宽：\"))\n",
    "\n",
    "perimeter = (length + width) * 2\n",
    "area = length * width\n",
    "\n",
    "print(\"周长是：\", perimeter)\n",
    "print(\"面积是：\", area)"
   ]
  }
 ],
