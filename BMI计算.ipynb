   "source": [
    "# 计算BMI\n",
    "height = float(input(\"请输入身高（米）：\"))\n",
    "weight = float(input(\"请输入体重（公斤）：\"))\n",
    "\n",
    "bmi = weight / (height * height)\n",
    "\n",
    "print(\"你的BMI是：\", bmi)"
   ]
  }
